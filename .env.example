# ==============================================================================
# RFR BY RIYAS — CLIENT ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local (do NOT commit .env.local to Git)
# 2. Retrieve your project credentials from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Publishable / Public Key
# 3. NEVER put your service_role secret key or admin passwords in this file.
# ==============================================================================

# Supabase Project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Public API Key (safe for public client bundles)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

